# Google AI Studio API key (https://aistudio.google.com/apikey). Required.
GEMINI_API_KEY=

# Optional model overrides (defaults shown)
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# GEMINI_EVAL_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Clerk authentication (https://dashboard.clerk.com → Configure → API keys). Required in production.
# In local development they can stay empty: Clerk then creates a temporary "keyless" app
# (stored in .clerk/) that you can claim from the prompt in the corner of the page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe subscriptions (https://dashboard.stripe.com/apikeys). Without these the app still
# works, but only the free trial allowance is available and the plans cannot be bought.
STRIPE_SECRET_KEY=
# Signing secret of the /api/billing/webhook endpoint (Stripe → Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=

# Price ids of the three monthly plans, created in the Stripe product catalogue.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=

# Absolute URL of this deployment. Only needed when Stripe has to be sent back to a different
# address than the request's own host (custom proxy setups).
# NEXT_PUBLIC_APP_URL=https://example.com

# Tokens a live session is assumed to cost per second, used to size the hold taken when a test
# starts and to bound what a finished test can be charged. Re-tune after measuring real tests.
# BILLING_LIVE_TOKENS_PER_SECOND=100
